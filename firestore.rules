rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDashboardAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == "__ADMIN_EMAIL__";
    }

    // The static E-TECH dashboard is read-only.
    // GitHub Actions uses Firebase Admin SDK and is controlled by IAM,
    // so it is not restricted by these client security rules.
    match /{document=**} {
      allow read: if isDashboardAdmin();
      allow create, update, delete: if false;
    }
  }
}
